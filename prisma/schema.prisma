// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  clerkUserId           String                 @unique // clerk user id
  email                 String                 @unique
  name                  String?
  imageUrl              String?
  industry              String? // Combined industry-subindustry (e.g., "tech-software-development")
  industryInsight       IndustryInsight?       @relation(fields: [industry], references: [industry])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  courseRecommendations CourseRecommendation[]

  // Profile fields
  bio        String?
  experience Int? // Years of experience

  // Relations
  skills           String[] // Array of skills
  assessments      Assessment[]
  resumes          Resume[] // FIXED: Changed from 'resume Resume?' to 'resumes Resume[]'
  coverLetter      CoverLetter[]
  roadmaps         Roadmap[]
  careerDiscovery  CareerDiscovery?
  profile          UserProfile?
  module2Attempts  Module2Attempt[]
  riasecAttempts   RiasecAttempt[]
  module4Runs      Module4RecommendationRun[]
  module4SavedCareers Module4SavedCareer[]
  module4Preferences Module4CareerPreference?
  module4Goals     Module4CareerGoal[]
  careerPreparationPlans CareerPreparationPlan[]
  careerPreparationTasks CareerPreparationTask[]
  careerPreparationAttempts CareerPreparationAttempt[]
  mockInterviewSessions MockInterviewSession[]
}

model Assessment {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  quizScore      Float // Overall quiz score
  questions      Json[] // Array of {question, answer, userAnswer, isCorrect}
  category       String // "Technical", "Behavioral", etc.
  improvementTip String? // AI-generated improvement tip
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model CoverLetter {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  content        String // Markdown content
  jobDescription String?
  companyName    String // Name of the company applying to
  jobTitle       String // Position applying for
  status         String   @default("draft") // draft, completed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

model AssessmentQuestion {
  id                  String   @id
  contentHash         String   @unique
  branches            String[] @default([])
  subject             String
  topic               String
  subtopic            String?
  difficulty          String
  type                String
  questionText        String   @db.Text
  options             Json?
  answerKey           String?
  explanation         String?  @db.Text
  inputFormat         String?  @db.Text
  outputFormat        String?  @db.Text
  constraints         String?  @db.Text
  starterCode         Json?
  publicTestCases     Json?
  privateTestCases    Json?
  supportedLanguages  String[] @default([])
  marks               Float    @default(1)
  negativeMarks       Float    @default(0)
  timeLimitSeconds    Int?
  memoryLimitMb       Int?
  sourceTitle         String?
  sourceUrl           String?
  languageVersion     String?
  generationModel     String?
  validationMetadata  Json?
  validationStatus    String   @default("GENERATED")
  isReleased          Boolean  @default(false)
  contentVersion      Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([validationStatus, isReleased])
  @@index([subject, topic, difficulty])
}

model Module2Blueprint {
  id              String   @id @default(cuid())
  branch          String
  version         Int
  durationMinutes Int
  maxMarks        Float
  sections        Json
  scoringPolicy   Json
  isActive        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([branch, version])
  @@index([branch, isActive])
}

enum Module2AttemptStatus {
  GENERATING
  ACTIVE
  SUBMITTED
  EXPIRED
  GENERATION_FAILED
}

model Module2Attempt {
  id               String               @id
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch           String
  blueprintVersion Int
  blueprint        Json
  questions        Json?
  answers          Json                 @default("{}")
  result           Json?
  status           Module2AttemptStatus @default(GENERATING)
  startedAt        DateTime?
  deadlineAt       DateTime?
  submittedAt      DateTime?
  completionReason String?
  cameraConsent    Boolean              @default(false)
  leaderboardOptIn Boolean              @default(false)
  questionTime     Json                 @default("{}")
  cooldownUntil    DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  integrityEvents  Module2IntegrityEvent[]
  codingSubmissions Module2CodingSubmission[]

  @@index([userId, createdAt])
  @@index([userId, cooldownUntil])
  @@index([status, deadlineAt])
}

model Module2QuestionSetCache {
  id              String   @id
  branch          String
  blueprintVersion Int
  questions       Json
  createdAt       DateTime @default(now())

  @@index([branch, blueprintVersion, createdAt])
}

enum RiasecAttemptStatus {
  IN_PROGRESS
  COMPLETE
}

model RiasecAttempt {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                RiasecAttemptStatus @default(IN_PROGRESS)
  questionSetVersion    Int                 @default(1)
  scoringAlgorithmVersion Int               @default(1)
  questions             Json
  responses             Json                @default("{}")
  scores                Json?
  interestCode          String?
  interpretation        String?             @db.Text
  completedAt           DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([userId, status, createdAt])
}

model Module4Career {
  id                String                     @id @default(uuid())
  slug              String                     @unique
  title             String
  family            String
  domain            String
  summary           String                     @db.Text
  description       String                     @db.Text
  responsibilities  Json
  workEnvironments  Json
  entryLevelRoles   Json
  tools             Json
  educationThemes   Json
  projectIdeas      Json
  learningResources Json                     @default("[]")
  competencyProgression Json                   @default("{}")
  qualifications    Json
  interestDimensions String[]
  technicalTopics   String[]
  adjacentSlugs     String[]
  sources           Json
  reviewedAt        DateTime
  isActive          Boolean                    @default(true)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  skillRequirements Module4CareerSkill[]
  recommendations  Module4CareerRecommendation[]
  savedBy           Module4SavedCareer[]
  selectedBy        Module4CareerGoal[]
  preparationPlans   CareerPreparationPlan[]
  mockInterviewSessions MockInterviewSession[]

  @@index([family, isActive])
  @@index([domain, isActive])
}

model Module4CareerSkill {
  id          String      @id @default(uuid())
  careerId    String
  career      Module4Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillName   String
  normalizedName String
  importance  String
  category    String
  evidenceTopics String[]
  sourceLabel String
  createdAt   DateTime    @default(now())

  @@unique([careerId, normalizedName])
  @@index([normalizedName])
}

model Module4RecommendationRun {
  id                  String                       @id @default(uuid())
  userId              String
  user                User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rankingMethod       String
  modelVersion        String
  featureSchemaVersion String
  dataSnapshot        Json
  limitations         Json
  explanationProvider String
  createdAt           DateTime                     @default(now())
  recommendations     Module4CareerRecommendation[]

  @@index([userId, createdAt])
}

model Module4CareerRecommendation {
  id        String                    @id @default(uuid())
  runId     String
  run       Module4RecommendationRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  careerId  String
  career    Module4Career             @relation(fields: [careerId], references: [id], onDelete: Cascade)
  rank      Int
  evidence  Json
  explanation String?                 @db.Text
  createdAt DateTime                  @default(now())
  selectedGoals Module4CareerGoal[]

  @@unique([runId, careerId])
  @@unique([runId, rank])
  @@index([careerId, createdAt])
}

model Module4SavedCareer {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId  String
  career    Module4Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  notes     String?     @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, careerId])
  @@index([userId, createdAt])
}

model Module4CareerGoal {
  id                 String                        @id @default(uuid())
  userId             String
  user               User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId           String
  career             Module4Career                 @relation(fields: [careerId], references: [id], onDelete: Restrict)
  recommendationId   String?
  recommendation     Module4CareerRecommendation?  @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  skillEvidence      Json
  skillGaps          Json
  isCurrent          Boolean                       @default(true)
  selectedAt         DateTime                      @default(now())
  endedAt            DateTime?
  preparationPlans   CareerPreparationPlan[]

  @@index([userId, isCurrent, selectedAt])
  @@index([careerId, selectedAt])
  @@index([recommendationId])
}

model Module4CareerPreference {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles     String[] @default([])
  domains   String[] @default([])
  interests String[] @default([])
  goals     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module2IntegrityEvent {
  id                String        @id
  attemptId         String
  attempt           Module2Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  eventType         String
  severity          String
  clientOccurredAt  DateTime?
  warningShown      Boolean       @default(false)
  metadata          Json?
  createdAt         DateTime      @default(now())

  @@index([attemptId, createdAt])
}

model Module2CodingSubmission {
  id         String        @id
  attemptId  String
  attempt    Module2Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  language   String
  sourceCode String        @db.Text
  mode       String
  status     String
  passed     Int?
  total      Int?
  evaluation Json?
  createdAt  DateTime      @default(now())

  @@index([attemptId, questionId, createdAt])
}

// Combined Industry Trends and Salary Insights
model IndustryInsight {
  id       String @id @default(cuid())
  industry String @unique // The industry this data belongs to (e.g., "tech-software-development")

  // Users in this industry
  users User[]

  // Salary data
  salaryRanges Json[] // Array of { role: string, min: float, max: float, median: float, location: string? }

  // Industry trends
  growthRate  Float // Industry growth rate
  demandLevel DemandLevel // "High", "Medium", "Low"
  topSkills   String[] // Most in-demand skills

  // Market conditions
  marketOutlook MarketOutlook // "Positive", "Neutral", "Negative"
  keyTrends     String[] // Array of current industry trends

  // Learning suggestions
  recommendedSkills String[] // Skills recommended for the industry

  lastUpdated DateTime @default(now())
  nextUpdate  DateTime // Scheduled update time

  @@index([industry])
}

model ChatSession {
  id         String    @id @default(cuid())
  userId     String
  title      String    @default("New Chat")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]
  resumeText String?   @db.Text

  @@index([userId])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  role      String // "user" | "assistant"
  content   String      @db.Text
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?   @db.Text
  status      String    @default("active") // "active" | "completed" | "paused"
  targetDate  DateTime?
  progress    Int       @default(0) // 0-100
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model UserProfile {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills     String[] @default([])
  interests  String[] @default([])
  education  String?
  experience String?
  targetRole String?
  profileData Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CourseRecommendation {
  id         String   @id @default(cuid())
  userId     String
  domain     String
  skills     String[]
  resumeText String?
  courses    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// RESUME BUILDER MODELS

model Resume {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title    String
  template String @default("modern") // modern, classic, minimal, professional

  // Personal Information
  fullName  String
  email     String
  phone     String
  location  String?
  linkedin  String?
  portfolio String?
  github    String?
  summary   String?

  // Resume Content
  experiences    Experience[]
  education      Education[]
  skills         Skill[]
  projects       Project[]
  certifications Certification[]

  // ATS Analysis
  atsScore       Int?
  atsAnalysis    Json?
  lastAnalyzedAt DateTime?

  // Metadata
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("resumes")
}

model Experience {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  company     String
  position    String
  location    String?
  startDate   String
  endDate     String?
  current     Boolean  @default(false)
  description String[] // Array of bullet points

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@map("experiences")
}

model Education {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  institution  String
  degree       String
  field        String
  location     String?
  startDate    String
  endDate      String?
  gpa          String?
  achievements String[]

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@map("education")
}

model Skill {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  category String // Technical, Soft Skills, Languages, Tools, etc.
  name     String
  level    String? // Beginner, Intermediate, Expert

  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([resumeId])
  @@map("skills")
}

model Project {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  name         String
  description  String
  technologies String[]
  link         String?
  github       String?
  startDate    String?
  endDate      String?
  highlights   String[]

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resumeId])
  @@map("projects")
}

model Certification {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  name          String
  issuer        String
  issueDate     String
  expiryDate    String?
  credentialId  String?
  credentialUrl String?

  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([resumeId])
  @@map("certifications")
}

model ATSAnalysisHistory {
  id       String @id @default(cuid())
  resumeId String

  score           Int
  analysis        Json
  recommendations Json

  createdAt DateTime @default(now())

  @@index([resumeId])
  @@map("ats_analysis_history")
}

model CareerDiscovery {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  education       String?
  experienceYears Int?
  currentRole     String?
  skills          String[] @default([])
  interests       String[] @default([])
  location        String?
  careerGoal      String?

  currentStep String @default("profile")

  careerRecommendations Json?
  selectedCareer        String?
  selectedCareerReason  String?
  skillGap              Json?
  roadmap               Json?
  courses               Json?
  learningPlan          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Roadmap {
  id        String   @id @default(cuid())
  userId    String
  title     String
  career    String
  months    Int
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CareerPreparationPlan {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId            String
  career              Module4Career @relation(fields: [careerId], references: [id], onDelete: Restrict)
  goalId              String?
  goal                Module4CareerGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  version             Int
  weeks               Int
  dailyHours          Float
  studyDays           Int
  startDate           DateTime @db.Date
  skillLevel          String
  learningPreference  String
  skillAnalysis       Json
  weeklyGoals         Json
  sourceSnapshot      Json
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tasks               CareerPreparationTask[]
  attempts            CareerPreparationAttempt[]

  @@unique([userId, version])
  @@index([userId, status, createdAt])
  @@index([goalId, createdAt])
}

model CareerPreparationTask {
  id                  String   @id @default(uuid())
  planId              String
  plan                CareerPreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekNumber          Int
  dayNumber           Int
  scheduledDate       DateTime @db.Date
  skill               String
  title               String
  description         String   @db.Text
  objectives          Json
  durationMinutes     Int
  activity            String   @db.Text
  completionCriteria  String   @db.Text
  resources           Json
  status              String   @default("pending")
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  attempts            CareerPreparationAttempt[]

  @@unique([planId, weekNumber, dayNumber])
  @@index([userId, status, weekNumber])
  @@index([planId, weekNumber, dayNumber])
}

model CareerPreparationAttempt {
  id                String   @id @default(uuid())
  submissionKey     String   @unique
  planId            String
  plan              CareerPreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId            String?
  task              CareerPreparationTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  kind              String
  weekNumber        Int
  attemptNumber     Int
  questionSnapshot  Json
  answers           Json
  score             Float
  passed            Boolean
  feedback          Json
  submittedAt       DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([userId, planId, submittedAt])
  @@index([planId, kind, weekNumber])
  @@index([taskId, kind, attemptNumber])
}

model MockInterviewSession {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId      String
  career        Module4Career @relation(fields: [careerId], references: [id], onDelete: Restrict)
  goalId        String?
  planId        String?
  careerTitle   String
  interviewType String
  difficulty    String
  duration      Int
  language      String   @default("English")
  questions     Json
  profileSnapshot Json
  status        String   @default("in_progress")
  report        Json?
  overallScore  Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  completedAt   DateTime?
  answers       MockInterviewAnswer[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([careerId, createdAt])
}

model MockInterviewAnswer {
  id          String   @id @default(uuid())
  sessionId   String
  session     MockInterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId  String
  answerText  String   @db.Text
  evaluation  Json
  score       Float
  submittedAt DateTime @default(now())

  @@unique([sessionId, questionId])
  @@index([sessionId, submittedAt])
}

enum DemandLevel {
  HIGH
  MEDIUM
  LOW
}

enum MarketOutlook {
  POSITIVE
  NEUTRAL
  NEGATIVE
}
